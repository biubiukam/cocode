# Copy this file to $COCODE_HOME/vision.yaml (default: ~/.cocode/vision.yaml).
# Store credential references only. Do not put API keys in this file.

provider: user
autoRead: true
fallbackToNative: true
timeoutMs: 45000

user:
  endpoint: https://api.openai.com/v1/chat/completions
  model: gpt-4o-mini
  credentialRef: OPENAI_API_KEY

# The Cocode route is optional. When omitted, the active Cocode account route
# is reused automatically and the vision model defaults to gpt-luna.
# cocode:
#   model: gpt-luna
#   credentialRef: COCODE_NUT_API_KEY
