# Shared DSH Host scope. Blank values use the official defaults.
# DSH_HOME=~/.dsh
# DSH_PROFILE=web
# COCODE_HOST_CONFIG_FINGERPRINT=cocode-web-jsonrpc-v1
# COCODE_RUNTIME_CHANNEL=stable

# Optional workspace and model overrides.
# COCODE_CWD=.
# DSH_CWD=.
# COCODE_PROVIDER=deepseek-official
# COCODE_MODEL=deepseek-v4-flash

# Debug product home. Do not put API keys in .env.
# COCODE_HOME=.dev/home
# DSH_SESSION_ROOT=.dev/home/sessions

# Optional Cocode account/API settings.
# COCODE_AGENCY_ORIGIN=https://cocode.agency
# COCODE_LANG=zh
# COCODE_TUI_SCREEN=inline
# COCODE_TUI_THEME=system

# Vision bridge settings are stored in $COCODE_HOME/vision.yaml.
