# Cocode Host scope. Runtime/profile are independent; business data uses the shared DSH home.
# COCODE_HOME=~/.cocode
# COCODE_DSH_HOME=~/.dsh
# DSH_HOME is derived from COCODE_DSH_HOME by the launcher.
# DSH_PROFILE is fixed to cocode for the Cocode Host.
# COCODE_HOST_CONFIG_FINGERPRINT=cocode-web-jsonrpc-v3
# COCODE_RUNTIME_CHANNEL=stable

# Optional workspace and model overrides.
# COCODE_CWD=.
# DSH_CWD=.
# COCODE_PROVIDER=deepseek-official
# COCODE_MODEL=deepseek-v4-flash

# Debug product/data homes. Do not put API keys in .env.
# COCODE_HOME=.dev/cocode-home
# COCODE_DSH_HOME=.dev/dsh-home
# DSH_SESSION_ROOT=.dev/dsh-home/sessions

# Optional Cocode account/API settings.
# COCODE_AGENCY_ORIGIN=https://cocode.agency
# COCODE_LANG=zh
# COCODE_TUI_SCREEN=inline
# COCODE_TUI_THEME=system
