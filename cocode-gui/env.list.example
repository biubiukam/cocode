# This file intentionally mirrors .env.release.example.
# Copy it to env.list for local release builds; never commit env.list.
ELECTRON_APP_ID=com.cocode.desktop
RELEASE_COPYRIGHT=Copyright © 2026 Cocode Contributors
RELEASE_DESCRIPTION=Cocode Desktop
RELEASE_HOMEPAGE=https://github.com/cocode-agency/cocode
ELECTRON_UPDATE_REPOSITORY=cocode-agency/cocode
ELECTRON_AUTO_UPDATE=1
ELECTRON_UPDATE_INTERVAL=10 minutes
MACOS_ICON_PATH=
WINDOWS_ICON_PATH=
DMG_ICON_PATH=
DMG_BACKGROUND_PATH=
DMG_FORMAT=UDZO
DMG_ICON_SIZE=96
MAC_SIGNING_IDENTITY=
MAC_SIGNING_KEYCHAIN=
MAC_ENTITLEMENTS_PATH=resources/entitlements.mac.plist
MAC_PLUGIN_ENTITLEMENTS_PATH=resources/entitlements.mac.plugin.plist
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
APPLE_KEYCHAIN_PROFILE=
APPLE_KEYCHAIN=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
WINDOWS_CERTIFICATE_FILE=
WINDOWS_CERTIFICATE_PASSWORD=
WINDOWS_TIMESTAMP_SERVER=http://timestamp.digicert.com
WINDOWS_SIGN_WITH_PARAMS=
