# Copy to .env.release for local release builds. Never commit .env.release.
# Release commands require a native runner for the target platform/architecture.

# Public application metadata. Override these for a downstream distribution.
ELECTRON_APP_ID=
RELEASE_COPYRIGHT=Copyright © 2026 Cocode Contributors
RELEASE_DESCRIPTION=Cocode Desktop
RELEASE_HOMEPAGE=https://github.com/cocode-agency/cocode

# Optional local asset paths. The defaults use Electron's icon when unset.
MACOS_ICON_PATH=
WINDOWS_ICON_PATH=
DMG_ICON_PATH=
DMG_BACKGROUND_PATH=
DMG_FORMAT=UDZO

# macOS signing. The certificate must already be installed in the selected keychain,
# or be imported by your local/CI setup before running the release command.
MAC_SIGNING_IDENTITY=
MAC_SIGNING_KEYCHAIN=
MAC_ENTITLEMENTS_PATH=resources/entitlements.mac.plist
MAC_PLUGIN_ENTITLEMENTS_PATH=resources/entitlements.mac.plugin.plist

# Choose exactly one notarization strategy:
# 1) App Store Connect API key path + ID + issuer.
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
# 2) A notarytool Keychain profile.
APPLE_KEYCHAIN_PROFILE=
APPLE_KEYCHAIN=
# 3) Apple ID + app-specific password + Team ID.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# Windows Authenticode signing. The PFX is local/CI-only and must not be committed.
WINDOWS_CERTIFICATE_FILE=
WINDOWS_CERTIFICATE_PASSWORD=
WINDOWS_TIMESTAMP_SERVER=http://timestamp.digicert.com
WINDOWS_SIGN_WITH_PARAMS=
