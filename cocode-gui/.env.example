# Harness endpoint used by the "connect" mode (remote / development).
# Leave unset on the desktop carrier to let Electron embed its own harness process.
COCODE_HARNESS_URL=http://127.0.0.1:3080

# Checkout that hosts the harness runtime for the embedded mode.
# The packaged app ships its own runtime and ignores this.
COCODE_HARNESS_PATH=../cocode-harness

# Force the desktop carrier into "connect" mode even when a runtime is available.
# COCODE_HARNESS_MODE=connect

# Official Cocode account origin. Desktop native login reads this in the main
# process; the browser carrier uses the VITE_ copy for device flow.
# COCODE_AGENCY_ORIGIN=https://cocode.agency
# VITE_COCODE_AGENCY_ORIGIN=https://cocode.agency
