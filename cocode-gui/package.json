{
  "name": "@cocode/gui-root",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "dev:web": "vite",
    "build": "pnpm run build:web && pnpm run build:electron",
    "build:web": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "package": "pnpm run build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && pnpm -r typecheck",
    "lint": "pnpm run check:layers && pnpm run check:design && pnpm run check:design-system && pnpm -r lint",
    "check:layers": "node scripts/check-layers.mjs",
    "check:design": "node scripts/check-design-tokens.mjs",
    "check:design-system": "node scripts/port-design-system.mjs --check",
    "port:design-system": "node scripts/port-design-system.mjs"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@cocode/gui-connection": "workspace:*",
    "@cocode/ui": "workspace:*",
    "@deepseek-ai/cordis": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:*",
    "@deepseek-ai/cosmokit": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.13.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ahooks": "^3.9.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.0",
    "immer": "^10.1.3",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.13.0",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.21",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "8.2.0"
  },
  "build": {
    "appId": "dev.cocode.gui",
    "productName": "Cocode",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
