{
	"name": "@cocode/gui-root",
	"productName": "Cocode",
	"version": "1.0.0",
	"description": "Cocode GUI Root",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cocode-agency/cocode.git"
	},
	"main": ".vite/build/main.js",
	"private": true,
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=22.12.0",
		"pnpm": "10.34.5"
	},
	"os": [
		"darwin",
		"win32",
		"linux"
	],
	"cpu": [
		"x64",
		"arm64"
	],
	"scripts": {
		"postinstall": "node scripts/harden-electron-default-app.mjs",
		"predev": "node scripts/harden-electron-default-app.mjs && corepack pnpm@10.34.5 run build:cocode-plugins && corepack pnpm@10.34.5 run build:supervisor",
		"dev": "node scripts/start-with-dsh-runtime.mjs",
		"dev:web": "vite --config vite.renderer.config.ts --port 5273",
		"prestart": "node scripts/harden-electron-default-app.mjs && corepack pnpm@10.34.5 run build:cocode-plugins && corepack pnpm@10.34.5 run build:supervisor",
		"start": "node scripts/start-with-dsh-runtime.mjs",
		"build:cocode-plugins": "node scripts/cocode-plugins.mjs build",
		"test:cocode-plugins": "node scripts/cocode-plugins.mjs test && corepack pnpm@10.34.5 --dir ../cocode-host-supervisor run test",
		"typecheck:cocode-plugins": "node scripts/cocode-plugins.mjs typecheck && corepack pnpm@10.34.5 --dir ../cocode-host-supervisor run typecheck",
		"stage:dsh": "node scripts/stage-dsh-runtime.mjs",
		"build:supervisor": "node scripts/build-supervisor.mjs",
		"build:runtime": "node scripts/build-runtime.mjs",
		"verify:runtime": "node scripts/verify-dsh-runtime.mjs --runtime-root .cache/cocode/release-runtime",
		"check:release-env": "node scripts/check-release-env.mjs",
		"prepackage": "node scripts/harden-electron-default-app.mjs && corepack pnpm@10.34.5 run build:runtime -- --clean",
		"package": "electron-forge package",
		"premake": "node scripts/harden-electron-default-app.mjs && corepack pnpm@10.34.5 run build:runtime -- --clean",
		"make": "electron-forge make",
		"release:mac:x64": "tsx scripts/release/build-release.ts --platform darwin --arch x64",
		"release:mac:arm64": "tsx scripts/release/build-release.ts --platform darwin --arch arm64",
		"release:win:x64": "tsx scripts/release/build-release.ts --platform win32 --arch x64",
		"release:win:arm64": "tsx scripts/release/build-release.ts --platform win32 --arch arm64",
		"publish": "electron-forge publish",
		"test": "tsx --test 'tests/**/*.test.ts'",
		"lint": "eslint --ext .js,.cjs,.mjs,.ts,.tsx --max-warnings=0 .",
		"lint:fix": "eslint --ext .js,.cjs,.mjs,.ts,.tsx --max-warnings=0 --fix .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"commitlint": "commitlint",
		"prepare": "husky",
		"check:env": "node scripts/check-env.mjs",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@commitlint/cli": "19.8.1",
		"@dtyq/eslint-config": "0.0.11",
		"@electron-forge/cli": "^7.11.2",
		"@electron-forge/maker-deb": "^7.11.2",
		"@electron-forge/maker-dmg": "7.11.2",
		"@electron-forge/maker-rpm": "^7.11.2",
		"@electron-forge/maker-squirrel": "^7.11.2",
		"@electron-forge/maker-zip": "^7.11.2",
		"@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
		"@electron-forge/plugin-fuses": "^7.11.2",
		"@electron-forge/plugin-vite": "^7.11.2",
		"@electron-forge/publisher-github": "7.11.2",
		"@electron/asar": "3.4.1",
		"@electron/fuses": "^1.8.0",
		"@electron/notarize": "2.5.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/electron-squirrel-startup": "^1.0.2",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@typescript-eslint/eslint-plugin": "^5.62.0",
		"@typescript-eslint/parser": "^5.62.0",
		"autoprefixer": "^10.5.4",
		"chokidar": "3.6.0",
		"electron": "43.4.0",
		"eslint": "^8.57.1",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"husky": "9.1.7",
		"lightningcss": "1.32.0",
		"lint-staged": "15.5.2",
		"postcss": "^8.5.26",
		"prettier": "2.8.8",
		"tailwindcss": "^3.4.19",
		"tsdown": "0.21.10",
		"tsx": "^4.23.12",
		"typescript": "~5.1.6",
		"vite": "^5.4.21"
	},
	"dependencies": {
		"@cocode/host-supervisor": "link:../cocode-host-supervisor",
		"@hookform/resolvers": "^5.7.1",
		"@radix-ui/react-accordion": "^1.2.20",
		"@radix-ui/react-alert-dialog": "^1.1.23",
		"@radix-ui/react-aspect-ratio": "^1.1.15",
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-checkbox": "^1.3.11",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-context-menu": "^2.3.7",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-hover-card": "^1.1.23",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-menubar": "^1.1.24",
		"@radix-ui/react-navigation-menu": "^1.2.22",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-progress": "^1.1.16",
		"@radix-ui/react-radio-group": "^1.4.7",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slider": "^1.4.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-switch": "^1.3.7",
		"@radix-ui/react-tabs": "^1.1.21",
		"@radix-ui/react-toast": "^1.2.23",
		"@radix-ui/react-toggle": "^1.1.18",
		"@radix-ui/react-toggle-group": "^1.1.19",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@shikijs/langs": "4.3.1",
		"anser": "2.3.5",
		"better-sqlite3": "^13.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"electron-squirrel-startup": "^1.0.1",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.4.2",
		"katex": "0.16.47",
		"lucide-react": "^1.31.0",
		"mdast-util-from-markdown": "2.0.3",
		"mdast-util-gfm": "3.1.0",
		"mdast-util-math": "3.0.0",
		"micromark-extension-gfm": "3.0.0",
		"micromark-extension-math": "3.1.0",
		"next-themes": "^0.4.6",
		"pino": "^10.3.1",
		"react": "^18.3.1",
		"react-day-picker": "^10.0.1",
		"react-dom": "^18.3.1",
		"react-hook-form": "^7.85.0",
		"react-resizable-panels": "^4.12.2",
		"shiki": "4.3.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tar": "^7.5.22",
		"update-electron-app": "3.3.0",
		"vaul": "^1.1.2",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	}
}
